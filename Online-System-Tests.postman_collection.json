						},
						"url": {
							"raw": "{{baseUrl}}/rest/attempts/1/submit",
							"host": ["{{baseUrl}}"],
							"path": ["rest", "attempts", "1", "submit"]
						},
						"description": "Student (alice, userId=1, ale používáme attempt 1) odešle pokus 1 (alice, DB Test 1, IN_PROGRESS). Automaticky se spustí autograder pro uzavřené otázky. Pokud test obsahuje open otázky, status bude SUBMITTED."
					}
				},
				{
